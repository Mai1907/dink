{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Dink",
  "options": {
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "Dink": {
      "deploymentTarget": "27.1",
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Dink",
          "NSCameraUsageDescription": "Dink uses the camera to capture your pet's teeth during a check-up.",
          "NSMotionUsageDescription": "Dink checks whether the phone is steady before capturing a scan.",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "DinkRevenueCatTestAPIKey": "$(DINK_REVENUECAT_TEST_API_KEY)",
          "DinkRevenueCatProductionAPIKey": "$(DINK_REVENUECAT_PRODUCTION_API_KEY)",
          "ITSAppUsesNonExemptEncryption": false,
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.e08255fd-f6c9-4aa2-9ab0-1712db917414",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1"
      },
      "dependencies": [
        { "package": "RevenueCat", "product": "RevenueCat" }
      ],
      "sources": [
        {
          "path": "App"
        }
      ],
      "type": "application"
    }
  },
  "packages": {
    "RevenueCat": {
      "url": "https://github.com/RevenueCat/purchases-ios.git",
      "from": "5.43.0"
    }
  }
}
